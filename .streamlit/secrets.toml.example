# CivilVision AI - Streamlit Secrets Configuration Example
# Copy this file to '.streamlit/secrets.toml' and replace with your actual Google Gemini API key.
# Alternatively, set the environment variable: export GEMINI_API_KEY="your_api_key_here"

GEMINI_API_KEY = "your_gemini_api_key_here"

# CivilVision AI Authentication Credentials
ADMIN_USERNAME = "admin"
ADMIN_PASSWORD = "CivilVision2026!"

# CivilVision AI External Action: Cloud Email API (Resend - Recommended for Streamlit Cloud)
# Get a free API key at https://resend.com (works reliably across all cloud hosts/ISPs without port blocks).
RESEND_API_KEY = "re_your_resend_api_key_here"
RESEND_FROM_EMAIL = "CivilVision AI <onboarding@resend.dev>"

# Optional Fallback: Gmail SMTP (Note: Ports 587/465 may be throttled/blocked on cloud servers)
GMAIL_ADDRESS = "your_email@gmail.com"
GMAIL_APP_PASSWORD = "your_16_char_app_password"


