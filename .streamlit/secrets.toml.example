# CivilVision AI - Streamlit Secrets Configuration Example
# Copy this file to '.streamlit/secrets.toml' and replace with your actual Google Gemini API key.
# Alternatively, set the environment variable: export GEMINI_API_KEY="your_api_key_here"

GEMINI_API_KEY = "your_gemini_api_key_here"

# CivilVision AI Authentication Credentials
ADMIN_USERNAME = "admin"
ADMIN_PASSWORD = "CivilVision2026!"

# CivilVision AI External Action: Email Notifications (Gmail SMTP)
# Set your Gmail address and 16-character Google App Password (not your normal account password).
# Generated from: Google Account -> Security -> 2-Step Verification -> App passwords
GMAIL_ADDRESS = "your_email@gmail.com"
GMAIL_APP_PASSWORD = "your_16_char_app_password"

